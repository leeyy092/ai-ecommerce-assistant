 # 启动：docker compose up -d --build
 # 地址：Web http://127.0.0.1:3000 ；健康检查 http://127.0.0.1:3000/api/health
 # 状态：docker compose ps（worker healthcheck 使用 dist/jobs/status.js）
-# 迁移：docker compose exec web pnpm exec prisma migrate deploy
+# 迁移：容器内无 pnpm（corepack 需联网），在宿主对暴露的 PG 端口执行：
+#   DATABASE_URL=postgresql://aiea:<POSTGRES_PASSWORD>@127.0.0.1:5433/aiea_dev \
+#     pnpm exec prisma migrate deploy
+# 初始化 Owner（镜像内含 dist/scripts bundle，无 pnpm 依赖）：
+#   docker compose exec -T web sh -c "printf '%s' '<密码>' | node dist/scripts/init-owner.js --org 组织 --email a@b.c --name 显示名"
 # M05：PostgreSQL/Web/Worker 统一引用同一 POSTGRES_PASSWORD；Web/Worker 通过
 #       PG* 分量注入连接参数（应用侧组装连接串并对口令做 URL 编码），口令含
 #       URL 保留字符（@ : / # ? % 等）也可用，无需手工转义。
+# G2-H09：Web/Worker 挂载同一私有存储卷（.data/private），上传→Worker 解析→
+#       查询/下载→容器重启读回共享同一对象；.data 不进 Git 与镜像上下文。
 name: ai-ecommerce-assistant
 
 services:
@@ -31,7 +37,7 @@ services:
 
   web:
     build: .
-    environment: &db-conn
+    environment: &app-env
       # M05：与 postgres 服务同一口令变量；应用与 prisma CLI 经 src/lib/dbUrl 组装连接串
       PGHOST: postgres
       PGPORT: "5432"
@@ -42,6 +48,12 @@ services:
       BETTER_AUTH_SECRET: ${BETTER_AUTH_SECRET:?BETTER_AUTH_SECRET is required (set it in .env)}
       BETTER_AUTH_URL: ${BETTER_AUTH_URL:-http://localhost:3000}
       LOG_LEVEL: info
+      # G2-H09：私有存储运行变量（local 驱动；oss 为 TASK-007/M04 显式适配）
+      STORAGE_DRIVER: ${STORAGE_DRIVER:-local}
+      STORAGE_PRIVATE_ROOT: /app/.data/private
+    volumes:
+      # G2-H09：Web 与 Worker 共享持久私有存储卷（任务文件跨进程、跨重启可读）
+      - private-data:/app/.data/private
     ports:
       - "127.0.0.1:3000:3000"
     depends_on:
@@ -52,13 +64,10 @@ services:
