-      # M05：与 web 相同的 PG* 分量（同一口令变量）
-      PGHOST: postgres
-      PGPORT: "5432"
-      PGUSER: aiea
-      PGPASSWORD: ${POSTGRES_PASSWORD:-aiea_local_dev}
-      PGDATABASE: aiea_dev
-      LOG_LEVEL: info
+      # G2-H09：与 Web 同一运行环境（含认证/存储变量），不再缺 auth 配置
+      <<: *app-env
+    volumes:
+      - private-data:/app/.data/private
     depends_on:
