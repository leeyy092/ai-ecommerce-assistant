+  const out: string[] = [];
+  for (let t = Date.parse(`${from}T00:00:00Z`); t < Date.parse(`${to}T00:00:00Z`); t += 86_400_000) {
+    const iso = new Date(t).toISOString().slice(0, 10);
+    if (!exclude.has(iso)) out.push(iso);
+  }
+  return out;
+}
