+/// 隔离，保存请求 hash 与响应 24 小时；同 key 不同 body 返回 409。
+/// 与业务自然键幂等（04 §12.5）分属两层，互不替代。
+model HttpIdempotency {
+  id             String   @id @default(uuid())
+  orgId          String   @map("org_id")
+  userId         String   @map("user_id")
+  endpoint       String   @db.VarChar(128)
