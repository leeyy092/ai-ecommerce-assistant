model AIRun {
  id              String          @id @default(uuid())
  orgId           String          @map("org_id")
  storeId         String          @map("store_id")
  kind            AiRunKind
  idempotencyKey  String          @unique @map("idempotency_key") @db.VarChar(64)
  attemptRevision Int             @default(1) @map("attempt_revision")
  datasetVersion  BigInt          @map("dataset_version")
  rulesetVersion  String          @map("ruleset_version") @db.VarChar(80)
  visibilityScope VisibilityScope @map("visibility_scope")
  status          AiRunStatus     @default(queued)
  modelId         String          @map("model_id") @db.VarChar(128)
  promptVersion   String          @map("prompt_version") @db.VarChar(128)
  schemaVersion   String          @map("schema_version") @db.VarChar(128)
  inputHash       String          @map("input_hash") @db.VarChar(64)
  inputTokens     BigInt?         @map("input_tokens")
  outputTokens    BigInt?         @map("output_tokens")
  reservedCost    Decimal         @map("reserved_cost") @db.Decimal(20, 6)
  actualCost      Decimal?        @map("actual_cost") @db.Decimal(20, 6)
  billingCurrency String          @default("CNY") @map("billing_currency") @db.Char(3)
  billingStatus   BillingStatus   @default(reserved) @map("billing_status")
  attempts        Json            @default("[]")
  requestContext  Json            @map("request_context")
  errorCode       String?         @map("error_code") @db.VarChar(64)
  startedAt       DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?       @map("finished_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion      Int              @default(1) @map("row_version")

  store      Store        @relation(fields: [orgId, storeId], references: [orgId, id])
  aiInsights AIInsight[]
  aiReports  AIReport[]

  @@unique([orgId, id])
  @@unique([orgId, storeId, id])
  @@index([orgId, storeId])
  @@index([orgId, status])
  @@index([billingStatus])
  @@map("ai_run")
}

model ImportTask {
  id                      String           @id @default(uuid())
  orgId                   String           @map("org_id")
  storeId                 String           @map("store_id")
  dataSourceId            String           @map("data_source_id")
  sourceKind              ImportSourceKind @map("source_kind")
  status                  ImportStatus     @default(uploaded)
  originalFilename        String           @map("original_filename") @db.VarChar(255)
  rawObjectKey            String           @map("raw_object_key") @db.VarChar(512)
  fileSha256              String           @map("file_sha256") @db.VarChar(64)
  mapping                 Json             @default("{}")
  coverageDeclaration     Json             @default("[]") @map("coverage_declaration")
  uploadRequestKey        String           @map("upload_request_key") @db.VarChar(64)
  idempotencyKey          String?          @map("idempotency_key") @db.VarChar(64)
  previewVersion          Int              @default(0) @map("preview_version")
  baseDatasetVersion      BigInt           @map("base_dataset_version")
  committedDatasetVersion BigInt?          @map("committed_dataset_version")
  committedRulesetVersion String?          @map("committed_ruleset_version") @db.VarChar(80)
  committedEvaluationAt   DateTime?        @map("committed_evaluation_at") @db.Timestamptz(6)
  rowCount                Int              @default(0) @map("row_count")
  validCount              Int              @default(0) @map("valid_count")
  errorCount              Int              @default(0) @map("error_count")
  insertCount             Int              @default(0) @map("insert_count")
  updateCount             Int              @default(0) @map("update_count")
  unchangedCount          Int              @default(0) @map("unchanged_count")
  stagingObjectKey        String?          @map("staging_object_key") @db.VarChar(512)
  errorObjectKey          String?          @map("error_object_key") @db.VarChar(512)
  outboxStatus            OutboxStatus     @default(none) @map("outbox_status")
  createdBy               String           @map("created_by")
  confirmedAt             DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  committedAt             DateTime?        @map("committed_at") @db.Timestamptz(6)
  errorCode               String?          @map("error_code") @db.VarChar(64)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion              Int              @default(1) @map("row_version")

  store            Store             @relation(fields: [orgId, storeId], references: [orgId, id])
  dataSource       DataSource        @relation(fields: [orgId, storeId, dataSourceId], references: [orgId, storeId, id])
  creator          User              @relation(fields: [createdBy], references: [id])
  products         Product[]
  skus             SKU[]
  orders           Order[]
  orderItems       OrderItem[]
  afterSaleRecords AfterSaleRecord[]
  refundEvents     RefundEvent[]
  adMetrics        AdMetric[]
  customerMessages CustomerMessage[]
  dataCoverages    DataCoverage[]

  @@unique([orgId, id])
  @@unique([orgId, storeId, id])
  @@unique([orgId, createdBy, uploadRequestKey])
  @@unique([orgId, storeId, idempotencyKey])
  @@index([orgId, storeId])
  @@index([orgId, storeId, status])
  @@index([outboxStatus, updatedAt])
  @@index([committedDatasetVersion])
  @@map("import_task")
}

model DataCoverage {
  id             String           @id @default(uuid())
  orgId          String           @map("org_id")
  storeId        String           @map("store_id")
  dataSourceId   String           @map("data_source_id")
  sourceKind     ImportSourceKind @map("source_kind")
  channel        CoverageChannel  @default(default_channel)
  coverageDate   DateTime         @map("coverage_date") @db.Date
  status         CoverageStatus
  explicitZero   Boolean          @default(false) @map("explicit_zero")
  recordCount    BigInt           @default(0) @map("record_count")
  datasetVersion BigInt           @map("dataset_version")
  importTaskId   String           @map("import_task_id")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion     Int              @default(1) @map("row_version")

  store      Store       @relation(fields: [orgId, storeId], references: [orgId, id])
  dataSource DataSource @relation(fields: [orgId, storeId, dataSourceId], references: [orgId, storeId, id])
  importTask ImportTask @relation(fields: [orgId, storeId, importTaskId], references: [orgId, storeId, id])

  @@unique([orgId, id])
  @@unique([orgId, storeId, dataSourceId, sourceKind, channel, coverageDate, datasetVersion])
  @@index([orgId, storeId])
  @@index([importTaskId])
  @@map("data_coverage")
}

model JobRun {
  id             String          @id @default(uuid())
  orgId          String          @map("org_id")
  storeId        String          @map("store_id")
  jobKind        JobKind         @map("job_kind")
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(64)
  context        Json
  resultManifest Json?           @map("result_manifest")
  actorType      ActorType       @default(user) @map("actor_type")
  requestedBy    String?         @map("requested_by")
  datasetVersion BigInt          @map("dataset_version")
  rulesetVersion String          @map("ruleset_version") @db.VarChar(80)
  status         JobStatus       @default(pending)
  attemptCount   Int             @default(0) @map("attempt_count")
  outboxStatus   JobOutboxStatus @default(pending) @map("outbox_status")
  errorCode      String?         @map("error_code") @db.VarChar(64)
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion     Int             @default(1) @map("row_version")

  store           Store  @relation(fields: [orgId, storeId], references: [orgId, id])
  requestedByUser User?  @relation(fields: [requestedBy], references: [id])

  @@unique([orgId, id])
  @@index([orgId, storeId])
  @@index([status, updatedAt])
  @@map("job_run")
}

model AuthRateLimit {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("auth_rate_limit")
}

model AuditLog {
  id            String    @id @default(uuid())
  orgId         String    @map("org_id")
  storeId       String?   @map("store_id")
  actorUserId   String?   @map("actor_user_id")
  actorType     ActorType @default(user) @map("actor_type")
  action        String    @db.VarChar(64)
  entityType    String    @map("entity_type") @db.VarChar(64)
  entityId      String    @map("entity_id")
  beforeSummary Json?     @map("before_summary")
  afterSummary  Json?     @map("after_summary")
  requestId     String    @map("request_id") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion    Int       @default(1) @map("row_version")

  organization Organization @relation(fields: [orgId], references: [id])
  // M07：审计同域复合外键（fk_audit_log_store_same_domain，SQL 迁移维护的按列 SET NULL）。
  // orgId 必填 + storeId 可空的混合可空性由 PG MATCH SIMPLE 语义支持。
  store        Store?       @relation(fields: [orgId, storeId], references: [orgId, id], onUpdate: Cascade, onDelete: SetNull)
  actorUser    User?        @relation(fields: [actorUserId], references: [id])

  @@unique([orgId, id])
  @@index([orgId, storeId, createdAt])
  @@index([orgId, entityType, entityId])
  @@index([requestId])
  @@map("audit_log")
}
