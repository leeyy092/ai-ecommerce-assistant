  unavailable
}

enum CoverageStatus {
  complete
  partial
  missing
}

enum Maturity {
  mature
  provisional
  not_applicable
}

enum VocBucketType {
  messages
  after_sales_case
}

enum RuleEvalStatus {
  triggered
  not_triggered
  suppressed
