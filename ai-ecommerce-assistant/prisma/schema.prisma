enum CoverageChannel {
  default_channel @map("default")
  case_channel    @map("case")
  refund_channel  @map("refund")
}

enum ActionStateStatus {
  pending
  accepted
  done
  dismissed
}

model User {
  id          String     @id @default(uuid())
  authUserId  String     @unique @map("auth_user_id")
  authUser    AuthUser   @relation("DomainUserAuth", fields: [authUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  email       String     @unique @db.VarChar(320)
  displayName String     @map("display_name") @db.VarChar(80)
  status      UserStatus @default(active)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships      Membership[]
  ownedOrgs        Organization[]
  invitationsSent  Invitation[]    @relation("InvitationInviter")
  invitationsTaken Invitation[]    @relation("InvitationAcceptor")
  skuAliases       SkuAlias[]
  importTasks      ImportTask[]
  actionStates     ActionState[]
  jobRunsRequested JobRun[]
  auditLogs        AuditLog[]

  @@index([status])
  @@map("domain_user")
}

model Organization {
  id                String    @id @default(uuid())
  name              String    @db.VarChar(100)
  ownerUserId       String    @unique @map("owner_user_id")
  status            OrgStatus @default(active)
  aiDailyBudget     Decimal   @default(3) @map("ai_daily_budget") @db.Decimal(20, 6)
  aiMonthlyBudget   Decimal   @default(100) @map("ai_monthly_budget") @db.Decimal(20, 6)
  budgetCurrency    String    @default("CNY") @map("budget_currency") @db.Char(3)
  budgetTimezone    String    @default("Asia/Shanghai") @map("budget_timezone") @db.VarChar(64)
  aiEnabled         Boolean   @default(true) @map("ai_enabled")
  dailyMessageLimit Int       @default(2000) @map("daily_message_limit")
  demoMode          Boolean   @default(false) @map("demo_mode")
  rowVersion        Int       @default(1) @map("row_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       User          @relation(fields: [ownerUserId], references: [id])
  memberships Membership[]
  invitations Invitation[]
  stores      Store[]
  auditLogs   AuditLog[]

  @@index([status])
  @@map("organization")
}

model Membership {
  id         String       @id @default(uuid())
  orgId      String       @map("org_id")
  userId     String       @map("user_id")
  role       MemberRole
  status     MemberStatus @default(active)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion Int          @default(1) @map("row_version")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([orgId, id])
  @@unique([orgId, userId])
  @@index([orgId, status])
  @@map("membership")
}

model Invitation {
  id         String           @id @default(uuid())
  orgId      String           @map("org_id")
  email      String           @db.VarChar(320)
  role       MemberRole
  tokenHash  String           @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  status     InvitationStatus @default(pending)
  invitedBy  String           @map("invited_by")
  acceptedBy String?          @map("accepted_by")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion Int              @default(1) @map("row_version")

  organization Organization @relation(fields: [orgId], references: [id])
  inviter      User         @relation("InvitationInviter", fields: [invitedBy], references: [id])
  acceptor     User?        @relation("InvitationAcceptor", fields: [acceptedBy], references: [id])

  @@unique([orgId, id])
  @@index([orgId, email])
  @@index([expiresAt])
  @@index([status])
  @@map("invitation")
}

model Store {
  id                             String         @id @default(uuid())
  orgId                          String         @map("org_id")
  name                           String         @db.VarChar(100)
  externalStoreId                String         @map("external_store_id") @db.VarChar(128)
  status                         StoreStatus    @default(active)
  demoMode                       Boolean        @default(false) @map("demo_mode")
  platform                       String         @db.VarChar(32)
  currency                       String         @db.Char(3)
  timezone                       String         @db.VarChar(64)
  datasetVersion                 BigInt         @default(0) @map("dataset_version")
  inputEvaluationAt              DateTime?      @map("input_evaluation_at") @db.Timestamptz(6)
  lastEvaluationDate             DateTime?      @map("last_evaluation_date") @db.Date
  currentSnapshotVersion         BigInt?        @map("current_snapshot_version")
  rulesetVersion                 String         @default("rules-v1-init") @map("ruleset_version") @db.VarChar(80)
  currentSnapshotRulesetVersion  String?        @map("current_snapshot_ruleset_version") @db.VarChar(80)
  currentSnapshotEvaluationAt    DateTime?      @map("current_snapshot_evaluation_at") @db.Timestamptz(6)
  previousSnapshotVersion        BigInt?        @map("previous_snapshot_version")
  previousSnapshotRulesetVersion String?        @map("previous_snapshot_ruleset_version") @db.VarChar(80)
  previousSnapshotEvaluationAt   DateTime?      @map("previous_snapshot_evaluation_at") @db.Timestamptz(6)
  snapshotStatus                 SnapshotStatus @default(ready) @map("snapshot_status")
  settings                       Json           @default("{}")
  createdAt                      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion                     Int            @default(1) @map("row_version")

  organization     Organization     @relation(fields: [orgId], references: [id])
  dataSources      DataSource[]
  ruleConfigs      RuleConfig[]
  products         Product[]
  skus             SKU[]
  skuAliases       SkuAlias[]
  orders           Order[]
  orderItems       OrderItem[]
  afterSaleRecords AfterSaleRecord[]
  refundEvents     RefundEvent[]
  adMetrics        AdMetric[]
  customerMessages CustomerMessage[]
  dailyMetrics     DailyMetric[]
  vocInsights      VOCInsight[]
  ruleEvaluations  RuleEvaluation[]
  alerts           Alert[]
  aiInsights       AIInsight[]
  actionStates     ActionState[]
  aiReports        AIReport[]
  aiRuns           AIRun[]
  importTasks      ImportTask[]
  dataCoverages    DataCoverage[]
  jobRuns          JobRun[]
  auditLogs        AuditLog[]

  @@unique([orgId, id])
  @@unique([orgId, externalStoreId])
  @@index([orgId, status])
  @@index([snapshotStatus])
  @@map("store")
}

model DataSource {
  id              String           @id @default(uuid())
  orgId           String           @map("org_id")
  storeId         String           @map("store_id")
  sourceNamespace String           @map("source_namespace") @db.VarChar(64)
  name            String           @db.VarChar(100)
  adapterKind     AdapterKind      @map("adapter_kind")
  status          DataSourceStatus @default(active)
  configuration   Json             @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion      Int              @default(1) @map("row_version")

  store         Store          @relation(fields: [orgId, storeId], references: [orgId, id])
  importTasks   ImportTask[]
  dataCoverages DataCoverage[]

  @@unique([orgId, id])
  @@unique([orgId, storeId, id])
  @@unique([orgId, storeId, sourceNamespace])
  @@index([orgId, storeId])
  @@map("data_source")
}

model RuleConfig {
  id             String    @id @default(uuid())
  orgId          String    @map("org_id")
  storeId        String    @map("store_id")
  ruleId         String    @map("rule_id") @db.VarChar(16)
  ruleVersion    Int       @default(1) @map("rule_version")
  rulesetVersion String    @map("ruleset_version") @db.VarChar(80)
  enabled        Boolean   @default(true)
  parameters     Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion     Int       @default(1) @map("row_version")

  store           Store            @relation(fields: [orgId, storeId], references: [orgId, id])
  alerts          Alert[]
  ruleEvaluations RuleEvaluation[]

  @@unique([orgId, id])
  @@unique([orgId, storeId, id])
  @@unique([orgId, storeId, rulesetVersion, ruleId, ruleVersion])
  @@index([orgId, storeId, rulesetVersion])
  @@map("rule_config")
}

model Product {
  id                String        @id @default(uuid())
  orgId             String        @map("org_id")
  storeId           String        @map("store_id")
  sourceNamespace   String        @map("source_namespace") @db.VarChar(64)
  sourceUpdatedAt   DateTime      @map("source_updated_at") @db.Timestamptz(6)
  importTaskId      String        @map("import_task_id")
  rowHash           String        @map("row_hash") @db.VarChar(64)
  externalProductId String        @map("external_product_id") @db.VarChar(128)
  name              String        @db.VarChar(300)
  category          String?       @db.VarChar(100)
  status            ProductStatus @default(active)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion        Int           @default(1) @map("row_version")

  store        Store         @relation(fields: [orgId, storeId], references: [orgId, id])
  importTask   ImportTask    @relation(fields: [orgId, storeId, importTaskId], references: [orgId, storeId, id])
  skus         SKU[]
  dailyMetrics DailyMetric[]

  @@unique([orgId, id])
  @@unique([orgId, storeId, id])
  @@unique([orgId, storeId, sourceNamespace, externalProductId])
  @@index([orgId, storeId])
  @@index([orgId, storeId, category])
  @@map("product")
}

model SKU {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  storeId         String    @map("store_id")
  sourceNamespace String    @map("source_namespace") @db.VarChar(64)
  sourceUpdatedAt DateTime  @map("source_updated_at") @db.Timestamptz(6)
  importTaskId    String    @map("import_task_id")
  rowHash         String    @map("row_hash") @db.VarChar(64)
  productId       String    @map("product_id")
  externalSkuId   String    @map("external_sku_id") @db.VarChar(128)
  skuCode         String    @map("sku_code") @db.VarChar(128)
  name            String    @db.VarChar(300)
  specification   String?   @db.VarChar(500)
  status          SkuStatus @default(active)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion      Int       @default(1) @map("row_version")

  store            Store             @relation(fields: [orgId, storeId], references: [orgId, id])
  importTask       ImportTask        @relation(fields: [orgId, storeId, importTaskId], references: [orgId, storeId, id])
  product          Product           @relation(fields: [orgId, storeId, productId], references: [orgId, storeId, id])
  orderItems       OrderItem[]
  customerMessages CustomerMessage[]
  skuAliases       SkuAlias[]

  @@unique([orgId, id])
  @@unique([orgId, storeId, id])
  @@unique([orgId, storeId, sourceNamespace, externalSkuId])
  @@unique([orgId, storeId, skuCode])
  @@index([orgId, storeId])
  @@index([orgId, storeId, productId])
  @@index([orgId, storeId, status])
  @@map("sku")
}

model SkuAlias {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  storeId         String   @map("store_id")
  sourceNamespace String   @map("source_namespace") @db.VarChar(64)
  externalSkuId   String   @map("external_sku_id") @db.VarChar(128)
  skuId           String   @map("sku_id")
  createdBy       String   @map("created_by")
