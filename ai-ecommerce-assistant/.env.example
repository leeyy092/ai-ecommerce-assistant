# ============================================================
# AI 电商运营助手｜环境变量样例
# 复制为 .env 使用；秘密值一律留空，不填写真实生产密钥。
# 真实 .env 不入 Git；分阶段生效说明见 DEVELOPMENT_HANDOFF §4.4。
# ============================================================

# --- 数据库（TASK-001 起必填）---------------------------------
# PostgreSQL 17 连接串。本机开发实例的启动方式见 README。
# M05：本地容器栈的口令由 POSTGRES_PASSWORD 统一提供（postgres/web/worker
# 共用；应用与 prisma CLI 经 src/lib/dbUrl 组装并自动 URL 编码，口令可含
# 任意字符）。不设置时使用 compose 内默认开发口令（仅限本机回环）。
DATABASE_URL=
# POSTGRES_PASSWORD=

# --- 认证（TASK-003 启用认证时必填；当前阶段可留空启动）-------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- LLM（TASK-017 接入模型时必填；未配置时 Web/Worker 仍可启动，
#     且不得为通过启动发起任何收费调用）------------------------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
AI_MODEL_ID=

# --- 文件存储（默认本地私有目录；设为 oss 时以下 OSS 变量必填）--
STORAGE_DRIVER=local
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# --- 日志（debug/info/warn/error）-----------------------------
LOG_LEVEL=info
