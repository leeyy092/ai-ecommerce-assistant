{
  "name": "ai-ecommerce-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build && pnpm build:worker && pnpm build:scripts",
    "start": "next start",
    "build:worker": "esbuild src/jobs/worker.ts src/jobs/status.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist/jobs --external:ali-oss --external:proxy-agent --banner:js=\"var __aieaImportMetaUrl=require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=__aieaImportMetaUrl",
    "worker:dev": "tsx src/jobs/worker.ts",
    "worker:start": "node dist/jobs/worker.js",
    "worker:status": "tsx src/jobs/status.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy PRISMA_HIDE_UPDATE_MESSAGE=1 vitest run tests/integration --maxWorkers=1 --minWorkers=1",
    "test:e2e": "playwright test",
    "build:scripts": "esbuild scripts/init-owner.ts scripts/reset-owner-password.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist/scripts --external:ali-oss --external:proxy-agent --banner:js=\"var __aieaImportMetaUrl=require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=__aieaImportMetaUrl"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "^1.7.4",
    "busboy": "^1.6.0",
    "csv-parse": "^5.6.0",
    "next": "16.3.5",
    "pg": "^8.16.0",
    "pg-boss": "^12.32.0",
    "pino": "^10.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@tailwindcss/postcss": "^4",
    "@types/ali-oss": "^6.23.3",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24",
    "@types/pg": "^8.15.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ali-oss": "^6.23.0",
    "esbuild": "^0.25.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
