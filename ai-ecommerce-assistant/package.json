  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build && pnpm build:worker",
    "start": "next start",
    "build:worker": "esbuild src/jobs/worker.ts src/jobs/status.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist/jobs",
    "worker:dev": "tsx src/jobs/worker.ts",
    "worker:start": "node dist/jobs/worker.js",
    "worker:status": "tsx src/jobs/status.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
